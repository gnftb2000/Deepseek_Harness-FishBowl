{
  "name": "dsh-fishbowl",
  "version": "0.3.1",
  "description": "Fishbowl（鱼缸）：给 DSH 里的 AI 角色一个跨会话、跨项目的身份连续性层（Soul 注入 / 记忆整理 / 语义冲突处理 / 审核队列 / git 版本化）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ai-persona",
    "long-term-memory",
    "memory",
    "memory-conflict",
    "ai-companion"
  ],
  "license": "MIT",
  "author": "Fishbowl contributors",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "icon.svg",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
